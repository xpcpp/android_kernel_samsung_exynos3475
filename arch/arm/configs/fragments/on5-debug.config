# Debug/trace fragment for Galaxy On5 (Exynos3475, ARM32, Linux 3.10.108)
# Merged on top of lineage-on5ltetmo_defconfig by tools-ci/build.sh
CONFIG_LOCALVERSION="-lineageos-dbg"
# --- symbols / backtraces ---
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_FRAME_POINTER=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# --- ftrace ---
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_GENERIC_TRACER=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_STACK_TRACER=y
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_FUNCTION_PROFILER=y
CONFIG_EVENT_TRACING=y
CONFIG_TRACEPOINTS=y
# --- kprobes: 3.10 Kconfig has "KPROBES depends on MODULES", so MODULES must be on ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENT=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENT=y
CONFIG_PROBE_EVENTS=y
# --- perf ---
CONFIG_PERF_EVENTS=y
CONFIG_PROFILING=y
# --- crash / log persistence ---
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_FTRACE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y
# --- lock / memory / hang debugging ---
CONFIG_LOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_SCHED_DEBUG=y
CONFIG_SCHEDSTATS=y
CONFIG_TIMER_STATS=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_SLUB_DEBUG=y
CONFIG_DEBUG_STACK_USAGE=y
CONFIG_DEBUG_SG=y
# --- hw bring-up helpers (useful for mainline port) ---
CONFIG_DEBUG_PINCTRL=y
CONFIG_GPIO_SYSFS=y
CONFIG_PROC_DEVICETREE=y
CONFIG_CLK_DEBUG=y
CONFIG_REGMAP_DEBUG=n
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_DEBUG_USER=y
# --- runtime-selectable pr_debug()/dev_dbg() for vendor drivers (bcmdhd, fimc-is, sm5703, ...) ---
CONFIG_DYNAMIC_DEBUG=y
# --- I2C (pmic, charger, fuelgauge, touch, camera sensors) ---
CONFIG_I2C_DEBUG_CORE=y
CONFIG_I2C_DEBUG_ALGO=y
CONFIG_I2C_DEBUG_BUS=y
# --- camera / V4L2 ---
CONFIG_VIDEO_ADV_DEBUG=y
# --- wifi ---
CONFIG_CFG80211_DEBUGFS=y
CONFIG_CFG80211_DEVELOPER_WARNINGS=y
CONFIG_CFG80211_REG_DEBUG=y
CONFIG_NL80211_TESTMODE=y
# --- charging / power / regulators ---
CONFIG_POWER_SUPPLY_DEBUG=y
CONFIG_REGULATOR_DEBUG=y
CONFIG_DEBUG_GPIO=y
CONFIG_PM_TEST_SUSPEND=y
CONFIG_SUSPEND_TIME=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_STAT_DETAILS=y
